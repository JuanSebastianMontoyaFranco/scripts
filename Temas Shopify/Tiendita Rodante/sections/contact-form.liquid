{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign has_custom_fields = false
  for block in section.blocks
    if block.type == 'custom_field'
      assign has_custom_fields = true
      break
    endif
  endfor
-%}

<div class="contact-form contact-form__content--{{ section.settings.content_alignment }}">
  <div class="container contact-form__container">
    {%- if section.settings.subheading != blank -%}
      <span class="contact-form__subtitle subtitle {% if section.settings.pulse_animation_text %}subtitle_dot{% endif %}">
        {{ section.settings.subheading }}
      </span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag | default: 'h2' }}
        class="contact-form__title {{ section.settings.heading_size }}"
      >
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag | default: 'h2' }}>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="contact-form__text">
        {{ section.settings.text }}
      </p>
    {%- endif -%}
    <div class="contact-form__inner">
      <div class="contact-form__wrapper">
        {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
          {%- if form.posted_successfully? -%}
            <div
              class="form-status form-status-list form__message"
              tabindex="-1"
              autofocus
            >
              {% render 'icon-success' %}
              {{ 'templates.contact.form.post_success' | t }}
            </div>
          {%- elsif form.errors -%}
          {%- endif -%}
          {%- if section.settings.show_name_field or section.settings.show_phone_field -%}
            <div class="contact-form__flex">
              {%- if section.settings.show_name_field -%}
                <div class="field field__name">
                  <input
                    class="field__input focus-inset"
                    autocomplete="name"
                    type="text"
                    id="{{ form_id }}-name"
                    name="contact[{{ 'templates.contact.form.name' | t }}]"
                    oninput="this.classList.toggle('has-content', this.value.length > 0)"
                    onfocus="this.classList.toggle('has-content', this.value.length > 0)"
                    onblur="this.classList.toggle('has-content', this.value.length > 0)"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    placeholder=""
                    {% if section.settings.name_field_required %}
                      required
                      aria-required="true"
                    {% endif %}
                    tabindex="0"
                  >
                  <label
                    class="field__label floating-field hidden"
                    for="{{ form_id }}-name"
                  >
                    {{ 'templates.contact.form.name' | t }}
                  </label>
                </div>
              {%- endif -%}
              {%- if section.settings.show_phone_field -%}
                <div class="field">
                  <input
                    type="tel"
                    id="{{ form_id }}-phone"
                    class="field__input  focus-inset"
                    autocomplete="tel"
                    oninput="this.classList.toggle('has-content', this.value.length > 0)"
                    name="contact[{{ 'templates.contact.form.phone' | t }}]"
                    pattern="[0-9\-]*"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    placeholder=""
                    {% if section.settings.phone_field_required %}
                      required
                      aria-required="true"
                    {% endif %}
                    tabindex="0"
                  >
                  <label
                    class="field__label floating-field hidden"
                    for="{{ form_id }}-phone"
                  >
                    {{- 'templates.contact.form.phone' | t -}}
                  </label>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="field field--with-error{% unless section.settings.show_message_field or section.settings.privacy_policy_consent or has_custom_fields %} field-last{% endunless %}">
            <input
              autocomplete="email"
              type="email"
              id="{{ form_id }}-email"
              class="field__input focus-inset"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              oninput="this.classList.toggle('has-content', this.value.length > 0)"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="{{ form_id }}-email-error"
              {% endif %}
              placeholder=""
              required
              tabindex="0"
            >
            <label
              class="field__label floating-field hidden"
              for="{{ form_id }}-email"
            >
              {{ 'templates.contact.form.email' | t }}
            </label>
            <small
              class="contact-form__field-error"
              id="{{ form_id }}-email-error"
              {% unless form.errors contains 'email' %}
                hidden
              {% endunless %}
            >
              <span class="visually-hidden">
                {{- 'accessibility.error' | t -}}
              </span>
              <span class="form__message">
                {%- if form.errors contains 'email' -%}
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                {%- else -%}
                  {{- 'templates.contact.form.email_invalid' | t -}}
                {%- endif -%}
              </span>
            </small>
          </div>
          <div class="contact-form__dynamic-fields">
            {%- for block in section.blocks -%}
              {%- if block.type == 'custom_field' -%}
                {% render 'contact-custom-field', block: block, section_id: section.id %}
              {%- endif -%}
            {%- endfor -%}
            {%- if section.settings.show_message_field -%}
              <div class="field{% unless section.settings.privacy_policy_consent %} field-last{% endunless %}">
              <textarea
                id="{{ form_id }}-body"
                class="text-area field__input  focus-inset"
                name="contact[{{ 'templates.contact.form.comment' | t }}]"
                placeholder=""
                oninput="this.classList.toggle('has-content', this.value.length > 0)"
                aria-required="true"
                required
                tabindex="0"
              >
                {{- form.body -}}
              </textarea>
              <label
                class="form__label field__label floating-field hidden"
                for="{{ form_id }}-body"
              >
                {{- 'templates.contact.form.comment' | t -}}
              </label>
            </div>
            {%- endif -%}
            {%- if section.settings.privacy_policy_consent -%}
              <div class="field field--checkbox field-last">
              <input
                type="checkbox"
                class="focus-inset"
                name="contact_privacy_policy_consent_{{ section.id }}"
                id="{{ form_id }}-privacy-policy-consent"
                aria-describedby="{{ form_id }}-privacy-policy-consent-error"
                required
                oninvalid="this.classList.add('is-invalid')"
                onchange="this.classList.remove('is-invalid')"
                tabindex="0"
              >
              <label for="{{ form_id }}-privacy-policy-consent">
                {% render 'icon-checkmark' %}
                <span class="body-small">
                  {{ 'sections.footer.accept_terms' | t }}
                  <a href="{{ shop.privacy_policy.url }}" target="_blank" class="focus-inset">
                    {{- shop.privacy_policy.title -}}
                  </a>
                </span>
              </label>
              <span id="{{ form_id }}-privacy-policy-consent-error" class="form__message form__message--error">
                {{- 'sections.footer.checkbox_error' | t -}}
              </span>
            </div>
            {%- endif -%}
          </div>
          <div class="contact-form__bottom">
            <button
              type="submit"
              class="button button--{{ section.settings.button_style }}  focus-inset"
              data-button-text="{{ 'templates.contact.form.send' | t }}"
              tabindex="0"
            >
              <span>{{ 'templates.contact.form.send' | t }}</span>
            </button>

            {% if section.settings.additional_text != blank %}
              <div class="contact-form__add-text richtext_custom">
                {{ section.settings.additional_text }}
              </div>
            {% endif %}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isValidEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function showEmailError(emailInput, errorMsg, message) {
      emailInput.setAttribute('aria-invalid', 'true');
      emailInput.setAttribute('aria-describedby', errorMsg.id);
      errorMsg.hidden = false;
      errorMsg.querySelector('.form__message').textContent = message;
    }

    function hideEmailError(emailInput, errorMsg) {
      emailInput.removeAttribute('aria-invalid');
      errorMsg.hidden = true;
    }

    document.querySelectorAll('.contact-form__form').forEach(function (form) {
      var emailInput = form.querySelector('input[type="email"]');
      var errorMsg = form.querySelector('.contact-form__field-error');
      var invalidMessage = {{ 'templates.contact.form.email_invalid' | t | json }};

      if (emailInput && errorMsg) {
        function validateEmail() {
          var email = emailInput.value.trim();
          if (email.length > 0 && !isValidEmail(email)) {
            showEmailError(emailInput, errorMsg, invalidMessage);
            return false;
          }
          hideEmailError(emailInput, errorMsg);
          return true;
        }

        emailInput.addEventListener('blur', validateEmail);
        emailInput.addEventListener('input', function () {
          if (emailInput.getAttribute('aria-invalid') === 'true') {
            validateEmail();
          }
        });

        form.addEventListener('submit', function (e) {
          if (!validateEmail()) {
            e.preventDefault();
            emailInput.focus();
          }
        });
      }

      form.querySelectorAll('.floating-field').forEach(function (label) {
        var inputElem = label.hasAttribute('for') ? document.getElementById(label.getAttribute('for')) : null;

        function toggleVisibility() {
          if (!inputElem) return;
          if (inputElem.value && inputElem.value.length > 0) {
            label.classList.add('hidden');
          } else {
            label.classList.remove('hidden');
          }
        }

        if (inputElem) {
          toggleVisibility();
          inputElem.addEventListener('blur', toggleVisibility);
          inputElem.addEventListener('focus', toggleVisibility);
          inputElem.addEventListener('input', toggleVisibility);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "spaced-section contact-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_alignment",
      "default": "left",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options.options__2.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options.options__1.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.content_options.header.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Contacts",
      "label": "t:sections.all.section-header.subheading.label"
    },
    {
      "type": "checkbox",
      "id": "pulse_animation_text",
      "label": "t:sections.all.pulse_animation_text.label",
      "default": false,
      "visible_if": "{{ section.settings.subheading != blank }}"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>Contact form</p>",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        },
        {
          "value": "p",
          "label": "t:sections.all.heading_tag.options__8.label"
        },
        {
          "value": "span",
          "label": "t:sections.all.heading_tag.options__9.label"
        }
      ]
    },
    {
      "type": "text",
      "id": "text",
      "default": "Details go here for your contact form. You can use multiple lines of text.",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "inline_richtext",
      "id": "additional_text",
      "default": "Additional text for contact form.",
      "label": "t:sections.contact-form.settings.additional_text.label"
    },
    {
      "type": "header",
      "content": "t:sections.contact-form.settings.form_fields.header"
    },
    {
      "type": "checkbox",
      "id": "show_name_field",
      "default": true,
      "label": "t:sections.contact-form.settings.show_name_field.label"
    },
    {
      "type": "checkbox",
      "id": "name_field_required",
      "default": true,
      "label": "t:sections.contact-form.settings.name_field_required.label",
      "visible_if": "{{ section.settings.show_name_field }}"
    },
    {
      "type": "checkbox",
      "id": "show_phone_field",
      "default": true,
      "label": "t:sections.contact-form.settings.show_phone_field.label"
    },
    {
      "type": "checkbox",
      "id": "phone_field_required",
      "default": false,
      "label": "t:sections.contact-form.settings.phone_field_required.label",
      "visible_if": "{{ section.settings.show_phone_field }}"
    },
    {
      "type": "checkbox",
      "id": "show_message_field",
      "default": true,
      "label": "t:sections.contact-form.settings.show_message_field.label"
    },
    {
      "type": "checkbox",
      "id": "privacy_policy_consent",
      "default": false,
      "label": "t:sections.contact-form.settings.privacy_policy_consent.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "custom_field",
      "name": "t:sections.contact-form.blocks.custom_field.name",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "options": [
            {
              "value": "text",
              "label": "t:sections.contact-form.blocks.custom_field.settings.type.options__1.label"
            },
            {
              "value": "textarea",
              "label": "t:sections.contact-form.blocks.custom_field.settings.type.options__2.label"
            },
            {
              "value": "checkbox",
              "label": "t:sections.contact-form.blocks.custom_field.settings.type.options__3.label"
            }
          ],
          "default": "text",
          "label": "t:sections.contact-form.blocks.custom_field.settings.type.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.contact-form.blocks.custom_field.settings.label.label",
          "default": "t:sections.contact-form.blocks.custom_field.settings.label.default",
          "visible_if": "{{ block.settings.type != 'checkbox' }}"
        },
        {
          "type": "inline_richtext",
          "id": "label_checkbox",
          "label": "t:sections.contact-form.blocks.custom_field.settings.label.label",
          "default": "t:sections.contact-form.blocks.custom_field.settings.label.default",
          "visible_if": "{{ block.settings.type == 'checkbox' }}"
        },
        {
          "type": "checkbox",
          "id": "is_required",
          "default": false,
          "label": "t:sections.contact-form.blocks.custom_field.settings.required.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
