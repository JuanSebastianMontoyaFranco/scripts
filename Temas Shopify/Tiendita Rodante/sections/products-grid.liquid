{{ 'section-products-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
<script src="{{ 'products-grid.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign quickview_hover = settings.quickview_hover
  assign show_on_mobile = settings.show_on_mobile
  assign quickview_show = settings.quickview_show
  assign type_color_swatch = settings.type_color_swatch
%}

{%- if quickview_show or show_on_mobile or type_color_swatch == 'custom' -%}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if quickview_show or show_on_mobile -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign section_heading = section.settings.section_heading
  assign section_heading_size = section.settings.section_heading_size
  assign section_heading_tag = section.settings.section_heading_tag
  assign section_subheading = section.settings.section_subheading
  assign section_heading_content_alignment = section.settings.section_heading_content_alignment
  assign pulse_animation_text = section.settings.pulse_animation_text
  assign grid_products = collections.all.products
  assign collection_handle = 'all'
  assign base_url = routes.all_products_collection_url
  assign total_shop_products = shop.products_count | default: 0
  assign swipe_on_mobile = section.settings.swipe_on_mobile
  assign columns_mobile = section.settings.columns_mobile
  assign products_per_page = section.settings.products_per_page
  assign columns_per_row = section.settings.columns_per_row
  assign quickview_hover = settings.quickview_hover
  assign show_swatches = section.settings.show_swatches
  assign image_ratio = section.settings.image_ratio
  assign image_fit = section.settings.image_fit
  assign show_secondary_image = section.settings.show_secondary_image
  assign show_vendor = section.settings.show_vendor
  assign show_collection = section.settings.show_collection
  assign show_desc = section.settings.show_desc
  assign columns_per_row = section.settings.columns_per_row

  if section.settings.collection != blank
    assign grid_products = section.settings.collection.products
    assign collection_handle = section.settings.collection.handle
    assign base_url = routes.collections_url | append: collection_handle
    assign total_shop_products = section.settings.collection.all_products_count
  endif

  if section.settings.product_list != blank
    assign grid_products = section.settings.product_list
    assign base_url = 'none'
    assign total_shop_products = section.settings.product_list.size
  endif

  assign sort = section.settings.sort

  case section.settings.sort
    when 'alphabetical'
      assign sort = 'title-ascending'
    when 'alphabetical_reversed'
      assign sort = 'title-descending'
    when 'products_high'
      assign sort = 'price-descending'
    when 'products_low'
      assign sort = 'price-ascending'
    when 'date'
      assign sort = 'created-ascending'
    when 'date_reversed'
      assign sort = 'created-descending'
    else
      assign sort = 'manual'
  endcase

  case sort
    when 'title-ascending', 'title-descending'
      assign grid_products = grid_products | sort: 'title'
    when 'price-descending', 'price-ascending'
      assign grid_products = grid_products | sort: 'price_min'
    when 'created-ascending', 'created-descending'
      assign grid_products = grid_products | sort: 'published_at'
    when 'manual'
      assign grid_products = grid_products | sort: 'manual'
    when 'best-selling'
      assign grid_products = grid_products | sort: 'manual'
  endcase

  if sort == 'price-descending' or sort == 'created-descending' or sort == 'title-descending'
    assign grid_products = grid_products | reverse
  endif

  assign is_dynamic_loading = false
  if total_shop_products > 50
    assign is_dynamic_loading = true
  elsif sort == 'manual' or sort == 'best-selling'
    if base_url != 'none'
      assign is_dynamic_loading = true
    endif
  endif

  if is_dynamic_loading and base_url != 'none'
    assign sort_params = '?sort_by=' | append: sort
    # Using Section Rendering API https://shopify.dev/docs/api/ajax/section-rendering
    assign collection_url = base_url | append: sort_params | append: '&section_id=' | append: section.id
    assign grid_products = collection.products
  else
    assign collection_url = 'none'
  endif

  assign class_swipe_products_grid = ''
  if swipe_on_mobile
    assign class_swipe_products_grid = 'swiper--products-grid'
  endif

  assign class_quickview_hover = ''
  if quickview_hover
    assign class_quickview_hover = 'quickview--hover'
  endif

  assign class_products_grid_loading = ''
  if total_shop_products > 50
    assign class_products_grid_loading = 'products-grid--loading'
  endif
%}

<div
  class="products-grid {{ class_products_grid_loading }}"
  data-total-shop-products="{{ total_shop_products }}"
  data-sort-type="{{ sort }}"
  data-base-url="{{ base_url }}"
  data-limit-products="{{ products_per_page }}"
  data-slider-mobile="{{ swipe_on_mobile }}"
  role="region"
  aria-label="{{ section_heading | escape }}"
>
  <div class="container">
    {% render 'section-header',
      section_heading: section_heading,
      section_heading_size: section_heading_size,
      section_heading_tag: section_heading_tag,
      section_subheading: section_subheading,
      content_alignment: section_heading_content_alignment,
      pulse: pulse_animation_text,
      id: 'products-grid-heading'
    %}

    <div class="products-grid__content">
      <div class="loading-overlay" aria-busy="true">
        <div class="loading-overlay__spinner">
          {% render 'icon-spinner' %}
        </div>
      </div>

      <div
        class="{{ class_swipe_products_grid }}"
        data-columns-mobile="{{ columns_mobile }}"
      >
        <ul
          class="products-grid__wrapper products-grid__wrapper--{{ columns_per_row }} products-grid__wrapper--{{ columns_mobile }}-mobile"
          role="list"
          aria-labelledby="products-grid-heading"
        >
          {% if grid_products.size > 0 %}
            {%- for product in grid_products limit: products_per_page -%}
              <li
                role="listitem"
                class="collection-product-card {{ class_quickview_hover }}"
              >
                {% render 'product-card',
                  product_card_product: product,
                  media_size: image_ratio,
                  media_fit: image_fit,
                  show_secondary_image: show_secondary_image,
                  show_vendor: show_vendor,
                  show_collection: show_collection,
                  show_desc: show_desc,
                  section_id: section.id,
                  columns: columns_per_row,
                  add_id: forloop.index,
                  content_alignment: 'left',
                  show_swatches: show_swatches,
                  heading_tag: section.settings.product_heading_tag
                %}
              </li>
            {%- endfor -%}
          {% else %}
            {%- for i in (1..4) -%}
              <li
                role="listitem"
                class="collection-product-card collection-product-card--placeholder"
                aria-hidden="true"
              >
                {% render 'product-card-placeholder',
                  media_size: image_ratio,
                  content_alignment: 'left',
                  product_index: forloop.index,
                  heading_tag: section.settings.product_heading_tag
                %}
              </li>
            {%- endfor -%}
          {% endif %}
        </ul>

        {%- if swipe_on_mobile -%}
          {% render 'swiper-nav' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

