{%- liquid
  assign body_font_light = settings.type_body_font | font_modify: 'weight', '300'
  assign body_font_regular = settings.type_body_font | font_modify: 'weight', '400'
  assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
  assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign heading_font_regular = settings.type_header_font | font_modify: 'weight', '400'
  assign heading_font_medium = settings.type_header_font | font_modify: 'weight', '500'
  assign section_heading_font_regular = settings.type_section_header_font | font_modify: 'weight', '400'
  assign section_heading_font_medium = settings.type_section_header_font | font_modify: 'weight', '500'
  assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic'

  assign countdown_font_regular = settings.countdown_font | font_modify: 'weight', '400'
  assign countdown_font_bold = settings.countdown_font | font_modify: 'weight', 'bold'
  assign countdown_font_extra_bold = settings.countdown_font | font_modify: 'weight', '800'
  assign countdown_font_black = settings.countdown_font | font_modify: 'weight', '900'
  assign countdown_font_italic = settings.countdown_font | font_modify: 'style', 'italic'

  assign type_img_banner_ticker_font_regular = settings.type_img_banner_ticker_font | font_modify: 'weight', '400'
  assign type_img_banner_ticker_font_bold = settings.type_img_banner_ticker_font | font_modify: 'weight', 'bold'
  assign type_img_banner_ticker_font_extra_bold = settings.type_img_banner_ticker_font | font_modify: 'weight', '800'
  assign type_img_banner_ticker_font_black = settings.type_img_banner_ticker_font | font_modify: 'weight', '900'
  assign type_img_banner_ticker_font_italic = settings.type_img_banner_ticker_font | font_modify: 'style', 'italic'

  assign product_count_font_regular = settings.product_count_font | font_modify: 'weight', '400'
  assign product_count_font_bold = settings.product_count_font | font_modify: 'weight', 'bold'
  assign product_count_font_extra_bold = settings.product_count_font | font_modify: 'weight', '800'
  assign product_count_font_black = settings.product_count_font | font_modify: 'weight', '900'
  assign product_count_font_italic = settings.product_count_font | font_modify: 'style', 'italic'

  assign badge_font_regular = settings.type_badge_font | font_modify: 'weight', '400'
  assign badge_font_bold = settings.type_badge_font | font_modify: 'weight', 'bold'
  assign badge_font_extra_bold = settings.type_badge_font | font_modify: 'weight', '800'
  assign badge_font_black = settings.type_badge_font | font_modify: 'weight', '900'
  assign badge_font_italic = settings.type_badge_font | font_modify: 'style', 'italic'
%}

{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_face: font_display: 'swap' }}
  {{ settings.type_tertiary_font | font_face: font_display: 'swap' }}
  {{ settings.type_section_header_font | font_face: font_display: 'swap' }}
  {{ settings.type_button_font | font_face: font_display: 'swap' }}
  {{ settings.type_header_font_card | font_face: font_display: 'swap' }}
  {{ settings.type_text_font_card | font_face: font_display: 'swap' }}
  {{ settings.type_subtitle_font | font_face: font_display: 'swap' }}
  {{ settings.type_header_menu_font | font_face: font_display: 'swap' }}
  {{ settings.type_footer_menu_font | font_face: font_display: 'swap' }}
  {{ settings.type_popups_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_popups_text_font | font_face: font_display: 'swap' }}

  {{ countdown_font_regular | font_face: font_display: 'swap' }}
  {{ countdown_font_bold | font_face: font_display: 'swap' }}
  {{ countdown_font_extra_bold | font_face: font_display: 'swap' }}
  {{ countdown_font_black | font_face: font_display: 'swap' }}
  {{ countdown_font_italic | font_face: font_display: 'swap' }}

  {{ type_img_banner_ticker_font_regular | font_face: font_display: 'swap' }}
  {{ type_img_banner_ticker_font_bold | font_face: font_display: 'swap' }}
  {{ type_img_banner_ticker_font_extra_bold | font_face: font_display: 'swap' }}
  {{ type_img_banner_ticker_font_black | font_face: font_display: 'swap' }}
  {{ type_img_banner_ticker_font_italic | font_face: font_display: 'swap' }}

  {{ product_count_font_regular | font_face: font_display: 'swap' }}
  {{ product_count_font_bold | font_face: font_display: 'swap' }}
  {{ product_count_font_extra_bold | font_face: font_display: 'swap' }}
  {{ product_count_font_black | font_face: font_display: 'swap' }}
  {{ product_count_font_italic | font_face: font_display: 'swap' }}

  {{ badge_font_regular | font_face: font_display: 'swap' }}
  {{ badge_font_bold | font_face: font_display: 'swap' }}
  {{ badge_font_extra_bold | font_face: font_display: 'swap' }}
  {{ badge_font_black | font_face: font_display: 'swap' }}
  {{ badge_font_italic | font_face: font_display: 'swap' }}

  {{ body_font_light | font_face: font_display: 'swap' }}
  {{ body_font_regular | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ heading_font_regular | font_face: font_display: 'swap' }}
  {{ heading_font_medium | font_face: font_display: 'swap' }}
  {{ section_heading_font_regular | font_face: font_display: 'swap' }}
  {{ section_heading_font_medium | font_face: font_display: 'swap' }}
  {{ heading_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}

  :root {
  	--font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  	--font-body-style: {{ settings.type_body_font.style }};
  	--font-body-weight: {{ settings.type_body_font.weight }};

  	--font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
  	--font-body-scale-xs: {{ settings.body_scale_xs | divided_by: 100.0 }};
  	--font-body-scale-s: {{ settings.body_scale_s | divided_by: 100.0 }};
  	--font-body-scale-m: {{ settings.body_scale_m | divided_by: 100.0 }};
  	--font-body-line-height: {{ settings.type_body_line_height }};
  	--font-body-letter-spacing: {{ settings.type_body_letter_spacing }}em;

  	--font-countdown: {{ settings.countdown_font.family }} , {{ settings.countdown_font.fallback_families }};
  	--font-countdown-style: {{ settings.countdown_font.style }};
  	--font-countdown-weight: {{ settings.countdown_font.weight }};

  	--font-img-banner-ticker-font: {{ settings.type_img_banner_ticker_font.family }}, {{ settings.type_img_banner_ticker_font.fallback_families }};
  	--font-img-banner-ticker-style: {{ settings.type_img_banner_ticker_font.style }};
  	--font-img-banner-ticker-weight: {{ settings.type_img_banner_ticker_font.weight }};

  	--font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};

  	--font-product-count: {{ settings.product_count_font.family }}, {{ settings.product_count_font.fallback_families }};
  	--font-product-count-style: {{ settings.product_count_font.style }};
  	--font-product-count-weight: {{ settings.product_count_font.weight }};

  	--font-tertiary-family: {{ settings.type_tertiary_font.family }}, {{ settings.type_tertiary_font.fallback_families }};
  	--font-heading-style: {{ settings.type_header_font.style }};
  	--font-heading-weight: {{ settings.type_header_font.weight }};
  	--font-heading-letter-spacing: {{ settings.type_header_letter_spacing }}em;
  	--font-heading-line-height: {{ settings.type_header_line_height }};
  	--font-heading-text-transform: {{ settings.type_header_text_transform }};

  	--font-section-heading-family: {{ settings.type_section_header_font.family }}, {{
  	settings.type_section_header_font.fallback_families }};
  	--font-section-heading-style: {{ settings.type_section_header_font.style }};
  	--font-section-heading-weight: {{ settings.type_section_header_font.weight }};

  	--font-subtitle-family: {{ settings.type_subtitle_font.family }}, {{ settings.type_subtitle_font.fallback_families }};
  	--font-subtitle-style: {{ settings.type_subtitle_font.style }};
  	--font-subtitle-weight: {{ settings.type_subtitle_font.weight }};
  	--font-subtitle-text-transform: {{ settings.subtitle_text_transform }};
  	--font-subtitle-scale: {{ settings.subtitle_scale | divided_by: 100.0 }};
  	--font-subtitle-scale-l: {{ settings.subtitle_scale_l | divided_by: 100.0 }};

  	--font-heading-h1-scale: {{ settings.heading_h1_scale | divided_by: 100.0 }};
  	--font-heading-h2-scale: {{ settings.heading_h2_scale | divided_by: 100.0 }};
  	--font-heading-h3-scale: {{ settings.heading_h3_scale | divided_by: 100.0 }};
  	--font-heading-h4-scale: {{ settings.heading_h4_scale | divided_by: 100.0 }};
  	--font-heading-h5-scale: {{ settings.heading_h5_scale | divided_by: 100.0 }};

  	--font-heading-card-family: {{ settings.type_header_font_card.family }}, {{
  	settings.type_header_font_card.fallback_families }};
  	--font-heading-card-style: {{ settings.type_header_font_card.style }};
  	--font-heading-card-weight: {{ settings.type_header_font_card.weight }};
  	--font-heading-card-transform: {{ settings.heading_text_transform_card }};
  	--font-text-card-family: {{ settings.type_text_font_card.family }}, {{ settings.type_text_font_card.fallback_families
  	}};
  	--font-text-card-style: {{ settings.type_text_font_card.style }};
  	--font-text-card-weight: {{ settings.type_text_font_card.weight }};

  	--font-heading-card-scale: {{ settings.heading_scale_card | divided_by: 100.0 }};
  	--font-text-card-scale: {{ settings.text_scale_card | divided_by: 100.0 }};

  	--font-button-family: {{ settings.type_button_font.family }}, {{ settings.type_button_font.fallback_families }};
  	--font-button-style: {{ settings.type_button_font.style }};
  	--font-button-weight: {{ settings.type_button_font.weight }};
  	--font-button-scale: {{ settings.button_scale | divided_by: 100.0 }};
  	--font-button-text-transform: {{ settings.button_text_transform }};
  	--font-button-letter-spacing: {{ settings.button_letter_spacing }}em;
  	--font-subtitle-letter-spacing: {{ settings.subtitle_letter_spacing }}em;

  	--font-badge-family: {{ settings.type_badge_font.family }}, {{ settings.type_badge_font.fallback_families }};
  	--font-badge-style: {{ settings.type_badge_font.style }};
  	--font-badge-weight: {{ settings.type_badge_font.weight }};
  	--font-badge-scale: {{ settings.badge_scale | divided_by: 100.0 }};
  	--font-badge-text-transform: {{ settings.badge_text_transform }};
  	--font-badge-letter-spacing: {{ settings.badge_letter_spacing }}em;

  	--font-header-menu-letter-spacing: {{ settings.header_menu_letter_spacing }}em;;
  	--font-footer-menu-letter-spacing: {{ settings.footer_menu_letter_spacing }}em;;
  	--font-big-menu-letter-spacing: -0.04em;

  	--font-header-menu-family: {{ settings.type_header_menu_font.family }}, {{
  	settings.type_header_menu_font.fallback_families }};
  	--font-header-menu-style: {{ settings.type_header_menu_font.style }};
  	--font-header-menu-weight: {{ settings.type_header_menu_font.weight }};
  	--font-header-menu-text-transform: {{ settings.header_menu_text_transform }};

  	--font-footer-menu-family: {{ settings.type_footer_menu_font.family }}, {{
  	settings.type_footer_menu_font.fallback_families }};
  	--font-footer-menu-style: {{ settings.type_footer_menu_font.style }};
  	--font-footer-menu-weight: {{ settings.type_footer_menu_font.weight }};
  	--font-footer-link-size: {{ settings.link_size_footer }}px;
  	--font-footer-bottom-link-size: {{ settings.link_size_footer_bottom }}px;

  	--font-popups-heading-family: {{ settings.type_popups_heading_font.family }}, {{
  	settings.type_popups_heading_font.fallback_families }};
  	--font-popups-heading-style: {{ settings.type_popups_heading_font.style }};
  	--font-popups-heading-weight: {{ settings.type_popups_heading_font.weight }};
  	--font-popups-text-family: {{ settings.type_popups_text_font.family }}, {{
  	settings.type_popups_text_font.fallback_families }};
  	--font-popups-text-style: {{ settings.type_popups_text_font.style }};
  	--font-popups-text-weight: {{ settings.type_popups_text_font.weight }};
  	--font-popup-heading-scale: {{ settings.popup_heading_scale | divided_by: 100.0 }};

  	--font-countdown-scale: {{ settings.countdown_font_size | divided_by: 100.0 }};
  	--font-popup-desc-scale: {{ settings.popup_desc_scale | divided_by: 100.0 }};
  	--font-popup-text-scale: {{ settings.popup_text_scale | divided_by: 100.0 }};
  	--font-notification-heading-scale: {{ settings.notification_heading_scale | divided_by: 100.0 }};
  	--font-notification-text-scale: {{ settings.notification_text_scale | divided_by: 100.0 }};
  }
{% endstyle %}
