{% comment %}
  All custom CSS in this file will be kept when updating the theme
  Write your custom CSS below
{% endcomment %}

/*RESPONSIVE*/
@media screen and (max-width: 820px) {
.noMobile {
  display: none;
}
}

@media screen and (min-width: 819px) {
.noDesk {
  display: none;
}
}

@media (max-width: 1080px) {
.noTablet {
  display: none;
}
}

/*SCROLL TO TOP button*/
@media screen and (min-width: 706px) {
    .m-button--scroll-top {
        right: 27px !important;
        bottom: 90px !important;
      }
    }

@media screen and (max-width: 705px) {
    .m-button--scroll-top {
        right: 30px !important;
        bottom: 149px !important;
    }
}

/*SIDEBAR COLLECTIONS*/
.m-collection-filters-form {
    margin-top: 30px !important;
    display: block;
}

/*PRODUCT CARD DISPLAY*/
.m-product-card {
  display: flex !important;
  flex-direction: column;
  height: 100%;
}
.m-product-card__content {
  display: flex !important;
  flex-direction: column;
  flex-grow: 1;
}
.m-product-card__info {
  margin-bottom: auto !important;
}
.main-product__block-inventory_status {
  display: none;
}

.m-product-card__media {
  border-bottom-right-radius: 0px;
  border-bottom-left-radius: 0px;
}
.m-product-card {
  background-color: #FFF;
  padding: 0px 15px 15px 15px;
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  border-bottom-right-radius: 0px;
  border-bottom-left-radius: 0px;
}
.m-product-card:hover{
  border-radius: 0px;
  box-shadow: 0 4px 20px #0003;
}

@media (max-width:767px){
.m-product-card {
  padding: 0px 10px 10px 10px;
}
}

/* 1. Limpieza total de subrayados, bordes y efectos del tema */
.block-text.rte a,
.block-text.rte a strong {
    text-decoration: none !important;
    border-bottom: 0 !important;
    background-image: none !important;
    box-shadow: none !important;
}

/* 2. Matamos los pseudo-elementos (la posible segunda línea) */
.block-text.rte a::after, 
.block-text.rte a::before {
    content: none !important;
    display: none !important;
}

/* 3. El efecto deseado: subrayado normal SOLO en hover */
.block-text.rte a:hover,
.block-text.rte a:hover strong {
    text-decoration: underline !important;
}

/*  FOOTER  */

.c-sedes-footer {
  @media (max-width:767px){
    flex-direction:column;
  }
  column-gap: 1rem; 
  align-items: flex-start; 
  text-align: left;
}
.c-links:hover {
  text-decoration: underline;
}

.block-text.rte a,
.block-text.rte a strong {
    text-decoration: none !important;
    border-bottom: 0 !important;
    background-image: none !important;
    box-shadow: none !important;
}
.block-text.rte a::after, 
.block-text.rte a::before {
    content: none !important;
    display: none !important;
}
.block-text.rte a:hover,
.block-text.rte a:hover strong {
    text-decoration: underline !important;
}

.c-columna-sede {
  font-size: .875rem;
  line-height: 1.25rem;
  padding-top: 1rem;
  gap: 0.625rem;
  padding-bottom: 1rem;
  text-align: center;
}

.m-footer__copyright {
  font-size: .875rem;
  line-height: 1.25rem;
  text-align: center;
}

.m-footer--bottom {
  border-top: 0px;
  padding: 20px 0;
}

.m-footer--bottom-inner {
  padding: 0;
  flex-direction: row;
  flex-wrap: wrap;
}

.m-footer--bottom-right {
  margin-bottom: 24px;
}

@media (min-width: 1024px) {
  .m-footer--bottom-inner {
    padding: 0;
    flex-direction: row;
  }
  
  .m-footer--bottom-right {
    margin-bottom: 0;
  }
  
  .c-columna-sede, .m-footer__copyright {
    text-align: left;
  }
}

.block-text.rte a {
  text-decoration: none !important;
  position: relative;
  display: inline-block;
}

.block-text.rte a::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 1px;
  bottom: 0;
  left: 0;
  background-color: transparent;
  transition: background-color 0.3s ease-in-out;
}

.block-text.rte a:hover::after {
  background-color: currentColor;
}

.m-button, .jm-button, .jm-sort-filter__select {
  border-radius: 0px;
}

@media (max-width: 820px) {
  .m-announcement-bar__item {
    overflow: hidden !important;
  }
  
  .m-announcement-bar__content {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    white-space: nowrap !important;
    width: 100% !important;
    font-size: 11px !important;
    padding: 0 !important;
  }
  
  .m-announcement-bar__content span {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 4px !important;
    padding: 0 !important;
  }
  
  .m-announcement-bar__content img {
    height: 12px !important;
    display: inline-block !important;
  } 
}


/* =========================================
   DISEÑO DEL POP-UP DE RECOGIDA EN TIENDA
   ========================================= */

/* 1. Separar cada sede en bloques individuales con espacio y una línea divisoria */
pickup-availability-drawer li,
.pickup-availability-list__item,
.m-pickup-availability-list__item {
  padding: 20px 0 !important;
  border-bottom: 1px solid #eaeaea !important;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* Ocultar la línea en la última sede para un acabado más limpio */
pickup-availability-drawer li:last-child,
.pickup-availability-list__item:last-child {
  border-bottom: none !important;
}

/* 2. Darle jerarquía y protagonismo al nombre de la sede */
pickup-availability-drawer h3,
.pickup-availability-list__item h3,
.pickup-availability-list__item h4,
.pickup-availability-list__item-title {
  font-size: 15px !important;
  font-weight: 700 !important;
  margin: 0 0 10px 0 !important;
  color: #000000 !important;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* 3. Limpiar la dirección: quitar cursiva y mejorar el interlineado */
pickup-availability-drawer address,
.pickup-availability-address {
  font-style: normal !important; /* Adiós cursivas */
  font-size: 14px !important;
  line-height: 1.6 !important;
  color: #555555 !important;
  margin-top: 0 !important;
}

/* 4. Resaltar el check verde y el mensaje de disponibilidad */
.pickup-availability-list__item-info p,
.pickup-availability-preview {
  margin: 0 0 10px 0 !important;
  font-size: 14px !important;
  font-weight: 500 !important;
  color: #2e7d32 !important; /* Un verde oscuro que da confianza */
}

/* =========================================
   EVITAR QUE EL MENÚ SE APILE EN LAPTOPS/TABLETS
   ========================================= */
@media screen and (min-width: 1025px) and (max-width: 1350px) {
  /* Evitamos que el contenedor haga salto de línea */
  .m-header__menu .m-menu {
    flex-wrap: nowrap !important;
    gap: 10px !important; /* Reduce el espacio general entre elementos */
  }

  /* Escalamos el tamaño y los espacios de cada link */
  .m-header__menu .m-menu__link--main {
    font-size: 13px !important; /* Letra un poco más pequeña */
    padding-left: 8px !important; /* Menos espacio invisible a la izquierda */
    padding-right: 8px !important; /* Menos espacio invisible a la derecha */
    white-space: nowrap !important; /* Obliga a que la palabra no se rompa */
  }
}