{%- comment -%} Krika: acordeon Descripcion / Como usar / Ideal para / Envios. La descripcion se toma de snippets/krika-desc (no la pisa activ-sync); si no hay, usa product.description {%- endcomment -%}
{%- capture kf_desc -%}{%- render 'krika-desc', product: product -%}{%- endcapture -%}
{%- assign kf_desc_clean = kf_desc | strip -%}
{%- if kf_desc_clean == blank -%}{%- assign kf_desc = product.description -%}{%- endif -%}
<div class="kf-acc">
  {%- if kf_desc != blank -%}
  <details class="kf-acc__item" open>
    <summary>Descripción</summary>
    <div class="kf-acc__body">{{ kf_desc }}</div>
  </details>
  {%- endif -%}
  {%- if product.metafields.custom.como_usar != blank -%}
  <details class="kf-acc__item">
    <summary>Cómo usar</summary>
    <div class="kf-acc__body">{{ product.metafields.custom.como_usar.value | escape | newline_to_br }}</div>
  </details>
  {%- endif -%}
  {%- if product.metafields.custom.ideal_para != blank -%}
  <details class="kf-acc__item">
    <summary>Ideal para y tips</summary>
    <div class="kf-acc__body">{{ product.metafields.custom.ideal_para.value | escape | newline_to_br }}</div>
  </details>
  {%- endif -%}
  <details class="kf-acc__item">
    <summary>Envíos, cambios y devoluciones</summary>
    <div class="kf-acc__body">
      <p><strong>Envíos a todo Colombia.</strong> El costo y el tiempo de entrega se calculan al finalizar la compra según tu ciudad. En Cali el envío es gratis, y al resto del país es gratis en compras desde $160.000.</p>
      <p><strong>Recogida en tienda</strong> disponible en Cali.</p>
      <p><strong>Cambios:</strong> puedes solicitarlo el primer día hábil después de recibir tu pedido. El producto debe estar nuevo, sin abrir, con sellos y empaque original, y con su factura. <a href="/policies/refund-policy">Ver política completa</a>.</p>
    </div>
  </details>
  <div class="kf-wa">
    <svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true"><path fill="#25D366" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3z"/><path fill="#fff" d="M22.6 18.8c-.4-.2-2.1-1-2.4-1.1-.3-.1-.6-.2-.8.2-.2.4-.9 1.1-1.1 1.3-.2.2-.4.3-.8.1-.4-.2-1.5-.6-2.9-1.8-1.1-1-1.8-2.1-2-2.5-.2-.4 0-.6.2-.8l.6-.7c.2-.2.3-.4.4-.7.1-.3 0-.5 0-.7l-1.1-2.6c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-1 .5-.3.4-1.3 1.2-1.3 3s1.3 3.5 1.5 3.7c.2.2 2.6 3.9 6.2 5.5 2.2.9 3 1 4.1.8.7-.1 2.1-.9 2.4-1.7.3-.8.3-1.5.2-1.7-.1-.1-.4-.2-.8-.4z"/></svg>
    <span>¿Tienes dudas? <a href="https://wa.me/573336025001?text={{ 'Hola, tengo una pregunta sobre: ' | append: product.title | url_encode }}" target="_blank" rel="noopener">Escríbenos por WhatsApp</a></span>
  </div>
</div>
<style>
.kf-acc{margin-top:18px;border-top:1px solid #e5e5e5}
.kf-acc__item{border-bottom:1px solid #e5e5e5}
.kf-acc__item summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:14px 2px;font-weight:600;font-size:15px}
.kf-acc__item summary::-webkit-details-marker{display:none}
.kf-acc__item summary::after{content:'';width:8px;height:8px;border-right:2px solid #222;border-bottom:2px solid #222;transform:rotate(45deg);transition:transform .2s;margin-right:4px}
.kf-acc__item[open] summary::after{transform:rotate(-135deg)}
.kf-acc__body{padding:0 2px 16px;font-size:14px;line-height:1.6;color:#333}
.kf-acc__body ul{margin:6px 0 0 18px;padding:0}
.kf-acc__body li{margin-bottom:4px}
.kf-acc__body p{margin:0 0 10px}
.kf-wa{display:flex;gap:8px;align-items:center;padding:14px 2px;font-size:14px}
.kf-wa a{font-weight:600;text-decoration:underline}
</style>
