        "custom_liquid_cmWPgk": {
          "type": "custom_liquid",
          "name": "Product Name Custom",
          "settings": {
            "custom_liquid": "<div class=\"product-premium-header\">\n  \n  <!-- 1. PROVEEDOR -->\n  {%- if product.vendor != blank -%}\n    <div class=\"product-vendor-wrapper\">\n      <a href=\"{{ product.vendor | url_for_vendor }}\" class=\"product-vendor-brand\">\n        {{ product.vendor }}\n      </a>\n    </div>\n  {%- endif -%}\n\n  <!-- 2. FILA DE TÍTULO + LISTA DE DESEOS -->\n  <div class=\"product-title-row\">\n    <h1 class=\"product-title-brand\">\n      {{ product.title }}\n    </h1>\n\n    <!-- Botón de Favoritos -->\n    <div class=\"product-wishlist-action\">\n      <button \n        type=\"button\" \n        class=\"wishlist-btn-trigger\" \n        data-product-handle=\"{{ product.handle }}\" \n        aria-label=\"Agregar a lista de deseos\" \n        onclick=\"toggleWishlist(this)\"\n      >\n        <svg class=\"wishlist-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n          <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n        </svg>\n      </button>\n    </div>\n  </div>\n\n  <!-- 3. PRECIO Y DESCUENTO -->\n  {%- assign current_variant = product.selected_or_first_available_variant -%}\n\n\n</div>\n\n<!-- SCRIPT DE INTERACCIÓN ACTUAlIZADO -->\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    const wishlistBtn = document.querySelector('.wishlist-btn-trigger');\n    if (!wishlistBtn) return;\n\n    const productHandle = wishlistBtn.getAttribute('data-product-handle');\n    let wishlist = JSON.parse(localStorage.getItem('shopify_wishlist_handles')) || [];\n\n    if (wishlist.includes(productHandle)) {\n      wishlistBtn.classList.add('is-active');\n    }\n  });\n\n  function toggleWishlist(button) {\n    const productHandle = button.getAttribute('data-product-handle');\n    let wishlist = JSON.parse(localStorage.getItem('shopify_wishlist_handles')) || [];\n\n    if (wishlist.includes(productHandle)) {\n      wishlist = wishlist.filter(handle => handle !== productHandle);\n      button.classList.remove('is-active');\n    } else {\n      wishlist.push(productHandle);\n      button.classList.add('is-active');\n    }\n\n    localStorage.setItem('shopify_wishlist_handles', JSON.stringify(wishlist));\n  }\n</script>"
          }
        },
