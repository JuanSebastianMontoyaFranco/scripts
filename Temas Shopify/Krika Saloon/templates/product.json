        "custom_liquid_zGy8dm": {
          "type": "custom_liquid",
          "name": "Prices & Disc. Custom",
          "settings": {
            "custom_liquid": "{%- assign current_variant = product.selected_or_first_available_variant -%}\n\n<div class=\"product-price-container\">\n  <!-- Precio actual / Oferta -->\n  <span class=\"price-current\">\n    {{ current_variant.price | money }}\n  </span>\n\n  <!-- Si el producto tiene un descuento activo (Precio de comparación) -->\n  {%- if current_variant.compare_at_price > current_variant.price -%}\n    <span class=\"price-compare\">\n      {{ current_variant.compare_at_price | money }}\n    </span>\n\n    <!-- Cálculo matemático del porcentaje de descuento -->\n    {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}\n    {%- assign percent = savings | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}\n    \n    <span class=\"price-discount-tag\">\n      -{{ percent }}%\n    </span>\n  {%- endif -%}\n</div>"
          }
        },
