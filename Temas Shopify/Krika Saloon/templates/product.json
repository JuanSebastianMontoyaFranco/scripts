        "custom_liquid_J6NYTd": {
          "type": "custom_liquid",
          "name": "Recogida New",
          "settings": {
            "custom_liquid": "<div class=\"delivery-options-section\">\n  <p class=\"delivery-options-title\">Opciones de entrega:</p>\n  \n  <div class=\"delivery-options-grid\">\n    <!-- Opción 1: Recogida en tienda -->\n    <div class=\"delivery-card\">\n      <div class=\"delivery-icon-wrapper\">\n        <svg class=\"delivery-svg-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </div>\n      <div class=\"delivery-info\">\n        <span class=\"delivery-label-main\">Recogida en tienda</span>\n        <span class=\"delivery-label-sub\">Cali</span>\n      </div>\n    </div>\n\n    <!-- Opción 2: Envío Nacional y Local -->\n    <div class=\"delivery-card\">\n      <div class=\"delivery-icon-wrapper\">\n        <svg class=\"delivery-svg-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n          <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"></line>\n        </svg>\n      </div>\n      <div class=\"delivery-info\">\n        <span class=\"delivery-label-main\">Envío Nacional</span>\n        <span class=\"delivery-label-sub\">Colombia</span>\n      </div>\n    </div>\n  </div>\n</div>"
          }
