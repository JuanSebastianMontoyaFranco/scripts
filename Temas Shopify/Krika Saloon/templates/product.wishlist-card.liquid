{% layout none %}
<div class="m-product-item custom-wishlist-item" style="position: relative; height: 100%;">
  
  <div class="cw-remove-btn-wrapper" 
       onclick="event.preventDefault(); window.removeFromWishlist('{{ product.handle }}', this);"
       style="position: absolute; top: 10px; right: 10px; z-index: 20; cursor: pointer;">
    
    <span class="cw-tooltip-text">
      {{ 'products.product.remove_from_wishlist' | t }}
    </span>

    <div class="cw-btn-icon">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"></path></svg>
    </div>
    
  </div>

  {%- render 'product-card-4', product: product, section: nil, index: 1, animated: false -%}
</div>