- liquid \n  assign accent_color = collection.metafields.custom.color_de_acento.value | default: collection.metafields.custom.color_de_acento | default: '#E6007E'\n-%}\n\n<style>\n  \/* =======================================================\n     TARJETAS DE PRODUCTO (Color de Acento Dinámico)\n     ======================================================= *\/\n\n  \/* Precio del producto *\/\n  .m-product-card__price, \n  .m-price,\n  .m-price-item {\n    color: {{ accent_color }} !important;\n  }\n\n  \/* Estrellas de calificación *\/\n  .m-product-card svg.m-svg-icon--star,\n  .jdgm-star,\n  .spr-icon-star,\n  .m-starrating svg,\n  .m-product-card .m-product-review svg {\n    color: {{ accent_color }} !important;\n    fill: {{ accent_color }} !important;\n  }\n\n\/* =========================================\n     BOTÓN \"LO QUIERO\" (Modo \"A prueba de balas\")\n     ========================================= *\/\n  .m-product-card .m-button,\n  .m-product-card .m-button--solid {\n    background-color: {{ accent_color }} !important;\n    border-color: {{ accent_color }} !important;\n    color: #ffffff !important;\n    \/* Forzamos las variables internas del tema Minimog *\/\n    --color-primary: {{ accent_color }} !important;\n    --btn-bg-color: {{ accent_color }} !important;\n    --btn-border-color: {{ accent_color }} !important;\n  }\n\n  \/* Anulamos cualquier borde, sombra o contorno en el hover *\/\n  .m-product-card .m-button:hover,\n  .m-product-card .m-button:focus,\n  .m-product-card .m-button:active {\n    background-color: {{ accent_color }} !important;\n    border-color: {{ accent_color }} !important;\n    outline-color: {{ accent_color }} !important;\n    box-shadow: 0 0 0 1px {{ accent_color }} inset !important; \/* Si usa sombra interior *\/\n    opacity: 0.8 !important;\n  }\n\n  \/* Matamos a los fantasmas en todos sus estados *\/\n  .m-product-card .m-button::before,\n  .m-product-card .m-button::after,\n  .m-product-card .m-button:hover::before,\n  .m-product-card .m-button:hover::after {\n    border-color: {{ accent_color }} !important;\n    box-shadow: none !important;\n    outline: none !important;\n  }\n\n  \/* =========================================\n     ETIQUETAS \/ BADGES (Nuevo, Descuento, etc.)\n     ========================================= *\/\n  \/* Atacamos directo a las clases rebeldes que encontraste *\/\n  .m-product-card .m-badge,\n  .m-product-card .m-color-dark {\n    background-color: {{ accent_color }} !important;\n    border-color: {{ accent_color }} !important;\n    color: #ffffff !important;\n  }\n.m-product-card .m-color-{\nbackground-color: #000;\n}\n\n#scroll-to-top-button {\n    background-color: {{ accent_color }} !important;\n    border-color: {{ accent_color }} !important;\n    color: #ffffff !important;\n  }\n  #scroll-to-top-button:hover,\n  #scroll-to-top-button:focus {\n    background-color: {{ accent_color }} !important;\n    border-color: {{ accent_color }} !important;\n    box-shadow: 0 0 0 .2rem {{ accent_color }} !important; \n    opacity: 0.8 !important;\n  }\n<\/style>","custom_class":""}}},"order":["collection-header","slider_t8TbqA","featured_collection_3ygic6","main","product_bundles_7eXjA6","featured_collection_CdzQJ9","slider_VrNnwC","scrolling_promotion_MYW6CX","recent-viewed","custom_code_eDdphm","custom_liquid_wRhJcT"]}