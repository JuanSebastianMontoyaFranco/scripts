<script>
(function(){
 function init(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root||root.dataset.horizontalReady)return;
  root.dataset.horizontalReady='true';
  var header=root.querySelector('.krika-header-full'),close=root.querySelector('.kr-alt-close-desktop');
  var items=Array.from(root.querySelectorAll('.krika-mega-nav .krika-mega-item[data-menu]'));
  var desktop=window.matchMedia('(min-width: 769px)');
  function size(){root.style.setProperty('--kr-menu-available',Math.max(100,window.innerHeight-header.getBoundingClientRect().bottom)+'px')}
  function shut(){
    items.forEach(function(item){item.classList.remove('is-active');item.querySelector('.krika-mega-link').setAttribute('aria-expanded','false');item.querySelector('.krika-mega-dropdown').inert=true});
    close.hidden=true;root.classList.remove('kr-navigation-open');
  }
  function open(item){if(!desktop.matches)return;shut();size();item.classList.add('is-active');item.querySelector('.krika-mega-link').setAttribute('aria-expanded','true');item.querySelector('.krika-mega-dropdown').inert=false;close.hidden=false;root.classList.add('kr-navigation-open')}
  items.forEach(function(item){
    var link=item.querySelector('.krika-mega-link');link.setAttribute('aria-haspopup','true');
    item.addEventListener('mouseenter',function(){open(item)});
    link.addEventListener('focus',function(){open(item)});
    link.addEventListener('click',function(e){if(desktop.matches&&!item.classList.contains('is-active')){e.preventDefault();open(item)}});
  });
  close.addEventListener('click',shut);
  root.querySelectorAll('.krika-mega-item:not([data-menu]) > .krika-mega-link').forEach(function(link){
    link.addEventListener('mouseenter',shut);
    link.addEventListener('focus',shut);
  });
  header.addEventListener('mouseleave',shut);
  root.addEventListener('keydown',function(e){if(e.key==='Escape'){shut();close.blur()}});
  document.addEventListener('click',function(e){if(!root.contains(e.target))shut()});
  header.addEventListener('focusout',function(e){if(!header.contains(e.relatedTarget))shut()});
  window.addEventListener('resize',function(){if(!desktop.matches)shut();else size()});
  shut();
 }
