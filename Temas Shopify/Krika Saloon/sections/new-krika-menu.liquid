<script>
  {% raw %}
  /* ===== HELPERS COMPARTIDOS v9 ===== */
  window.KRIKA_ALT = (function(){
    function norm(s){return ((s||'')+'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')}
    function norm2(s){return norm(s).replace(/[^a-z0-9]/g,'')}
    function shuffle(a){var r=a.slice();for(var i=r.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=r[i];r[i]=r[j];r[j]=t}return r}
    function pimg(p){
      if(!p)return '';
      var cand=[p.featured_image,p.image,(p.images&&p.images[0]),(p.media&&p.media[0]&&(p.media[0].preview_image||p.media[0].src))];
      for(var i=0;i<cand.length;i++){
        var v=cand[i];
        if(!v)continue;
        if(typeof v==='string')return v;
        if(typeof v==='object'){if(v.src)return v.src;if(v.url)return v.url;}
      }
      return '';
    }
    /* v9: solo productos CON STOCK y CON FOTO */
    function ok(p){
      if(!p)return false;
      if(!pimg(p))return false;
      var av=(typeof p.available==='boolean')?p.available:true;
      if(!av&&p.variants&&p.variants.length){
        for(var i=0;i<p.variants.length;i++){if(p.variants[i].available){av=true;break}}
      }
      return !!av;
    }
    function wurl(u){return u?(u.indexOf('?')!==-1?u+'&width=400':u+'?width=400'):u}
    function fmtCOP(v){return new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',minimumFractionDigits:0,maximumFractionDigits:0}).format(v||0)}
    var VMAP={},TMAP={};
    function addMaps(list){
      (list||[]).forEach(function(p){
        if(p&&p.vendor)VMAP[norm2(p.vendor)]=p.vendor;
        var t=p.type||p.product_type;
        if(t)TMAP[norm2(t)]=t;
      });
    }
    function fixParam(a,param,map){
      var href=a.getAttribute('href')||'';
      var idx=href.indexOf(param+'=');
      if(idx===-1)return;
      var val=href.slice(idx+param.length+1),rest='';
      var amp=val.indexOf('&');
      if(amp>-1){rest=val.slice(amp);val=val.slice(0,amp);}
      try{val=decodeURIComponent(val.replace(/\+/g,' '))}catch(e){}
      var real=map[norm2(val)];
      if(real){a.setAttribute('href',href.slice(0,idx)+param+'='+encodeURIComponent(real)+rest);}
    }
    function fixLinks(scope){
      if(!scope)return;
      scope.querySelectorAll('a[href*="filter.p.vendor"]').forEach(function(a){fixParam(a,'filter.p.vendor',VMAP)});
      scope.querySelectorAll('a[href*="filter.p.product_type"]').forEach(function(a){fixParam(a,'filter.p.product_type',TMAP)});
    }
    return {norm:norm,norm2:norm2,shuffle:shuffle,pimg:pimg,ok:ok,wurl:wurl,fmtCOP:fmtCOP,addMaps:addMaps,fixLinks:fixLinks,VMAP:VMAP,TMAP:TMAP,CK:'krika_alt_v3_c_',AK:'krika9_all'};
  })();

  /* ===== MEGA MENÚS WEB ===== */
  (function(){
    var K=window.KRIKA_ALT;
    var MENUS=['gafas','perfumes','capilar','skincare','maquillaje','corporal','unas','kits','descuentos'];
    function priceOf(p){try{return parseFloat(p.variants[0].price)||0}catch(e){return 0}}
    function renderKitsBrands(products,collectionKey){
      collectionKey=collectionKey||'kits';
      var lists=document.querySelectorAll('[data-brand-collection="'+collectionKey+'"]');
      if(!lists.length)return;
      var brands={};
      (products||[]).forEach(function(p){
        var vendor=(p&&p.vendor||'').toString().trim();
        var vendorKey=K.norm2(vendor);
        if(vendorKey&&vendorKey!=='krikasalon')brands[vendorKey]=vendor;
      });
      var names=Object.keys(brands).map(function(key){return brands[key]}).sort(function(a,b){return a.localeCompare(b,'es')});
      lists.forEach(function(list){
        list.innerHTML='';
        if(!names.length){
          var empty=document.createElement('li');
          empty.textContent='No hay proveedores disponibles en la colección.';
          list.appendChild(empty);
          return;
        }
        names.forEach(function(name){
          var li=document.createElement('li');
          var a=document.createElement('a');
          a.href='/collections/'+(collectionKey==='descuentos'?'sale':collectionKey)+'?filter.p.vendor='+encodeURIComponent(name);
          a.textContent=name.toLocaleLowerCase('es').replace(/(^|[\s-])(\p{L})/gu,function(match,separator,letter){
            return separator+letter.toLocaleUpperCase('es');
          });
          li.appendChild(a);
          list.appendChild(li);
        });
      });
    }
    K.renderKitsBrands=renderKitsBrands;
    function fetchKitsProducts(collectionKey){
      collectionKey=collectionKey==='descuentos'?'sale':(collectionKey||'kits');
      var page=1,all=[],limit=collectionKey==='sale'?50:250;
      function next(){
        return fetch('/collections/'+collectionKey+'/products.json?limit='+limit+'&page='+page).then(function(r){if(!r.ok)throw new Error('Collection HTTP '+r.status);return r.json()}).then(function(data){
          var batch=(data&&data.products)||[];
          all=all.concat(batch);
          if(collectionKey!=='sale'&&batch.length===limit&&page<20){page++;return next()}
          return all;
        });
      }
      return next();
    }
    K.fetchKitsProducts=fetchKitsProducts;
    var productRequests={};
    function loadMenuProducts(key){
      if(productRequests[key])return productRequests[key];
      var cached=null;
      try{cached=JSON.parse(sessionStorage.getItem(K.CK+key))}catch(e){}
      if(Array.isArray(cached)&&cached.filter(K.ok).length>=4)return Promise.resolve(cached);
      var page=1,all=[],limit=50;
      function next(){
        return fetch('/collections/'+key+'/products.json?limit='+limit+'&page='+page)
          .then(function(r){if(!r.ok)throw new Error('Collection HTTP '+r.status);return r.json()})
          .then(function(data){
            var batch=(data&&data.products)||[];
            all=all.concat(batch);
            if(all.filter(K.ok).length<4&&batch.length===limit){page++;return next()}
            try{if(all.length)sessionStorage.setItem(K.CK+key,JSON.stringify(all))}catch(e){}
            return all;
          });
      }
      productRequests[key]=next().finally(function(){delete productRequests[key]});
      return productRequests[key];
    }
    K.loadMenuProducts=loadMenuProducts;

    function renderProducts(products,container){
      container.innerHTML='';
      var vis=(products||[]).filter(K.ok); /* v9: sin stock / sin foto fuera */
      if(!vis.length){container.style.display='none';return}
      container.style.display='';
      K.shuffle(vis).slice(0,4).forEach(function(p){
        var img=K.wurl(K.pimg(p));
        var priceF=K.fmtCOP(priceOf(p));
        container.insertAdjacentHTML('beforeend','<div class="krika-mega-card"><a href="/products/'+p.handle+'"><div class="krika-mega-img">'+(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'</div><div class="krika-mega-info"><span class="krika-mega-brand">'+(p.vendor||'').toUpperCase()+'</span><h4 class="krika-mega-name">'+p.title+'</h4><span class="krika-mega-price">'+priceF+'</span></div></a></div>');
      });
    }
    function cacheOf(key){var c=sessionStorage.getItem(K.CK+key);if(c){try{var products=JSON.parse(c);if(Array.isArray(products)&&products.length)return products}catch(e){}}return null}
    function loadMenu(key){
      var container=document.querySelector('[data-menu="'+key+'"] .krika-mega-products');
      if(!container)return;
      var cached=cacheOf(key);
      if(cached&&cached.filter(K.ok).length>=4){K.addMaps(cached);if((key==='kits'||key==='descuentos'))renderKitsBrands(cached,key);K.fixLinks(document.querySelector('[data-menu="'+key+'"]'));renderProducts(cached,container);return}
      var request=(key==='kits'||key==='descuentos')?fetchKitsProducts(key):loadMenuProducts(key);
      request.then(function(prods){
        try{if(prods.length)sessionStorage.setItem(K.CK+key,JSON.stringify(prods))}catch(e){}
        K.addMaps(prods);
        if((key==='kits'||key==='descuentos'))renderKitsBrands(prods,key);
        K.fixLinks(document.querySelector('[data-menu="'+key+'"]'));
        renderProducts(prods,container);
      }).catch(function(){container.style.display='';container.innerHTML='<p class="krika-mega-loading">No fue posible cargar los productos. Vuelve a intentarlo.</p>'});
    }
    function init(){
      MENUS.forEach(function(k){
        loadMenu(k);
        var item=document.querySelector('[data-menu="'+k+'"]');
        if(item)item.addEventListener('mouseenter',function(){
          var c=cacheOf(k);
          if(c)renderProducts(c,document.querySelector('[data-menu="'+k+'"] .krika-mega-products'));
        });
      });
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else setTimeout(init,50);
  })();

  /* ===== BUSCADOR + DRAWER MÓVIL ===== */
  (function(){
    var K=window.KRIKA_ALT;
    var INIT=12, ADD=8, LS='krika_recent_searches', WK='krika_wishlist';
    var CATS=['gafas','perfumes','capilar','skincare','maquillaje','corporal','unas','kits','descuentos'];
    var ov=document.getElementById('alt_searchOverlay');
    var sInput=document.getElementById('alt_searchInput');
    var alt_btnClear=document.getElementById('alt_btnClear');
    var sMeta=document.getElementById('alt_searchMeta');
    var pGrid=document.getElementById('alt_productsGrid');
    var alt_btnMore=document.getElementById('alt_btnMore');
    var alt_btnSort=document.getElementById('alt_btnSort');
    var alt_sortMenu=document.getElementById('alt_sortMenu');
    var alt_btnFilters=document.getElementById('alt_btnFilters');
    var drawer=document.getElementById('alt_krikaDrawer');
    var aPrev=document.getElementById('alt_krSlidePrev');
    var aNext=document.getElementById('alt_krSlideNext');

    var allProds=[],allLoaded=false,shuffled=[];
    var state={q:'',sort:'relevance',visible:INIT,loading:false,suggestProds:[],suggestQueries:[]};

    function priceOf(p){
      if(p._sug)return p._price||0;
      try{return parseFloat(p.variants[0].price)||0}catch(e){return 0}
    }
    function cmpOf(p){
      if(p._sug)return p._cmp||0;
      try{var c=parseFloat(p.variants[0].compare_at_price);return isNaN(c)?0:c}catch(e){return 0}
    }
    function getWL(){try{return JSON.parse(localStorage.getItem(WK))||[]}catch(e){return[]}}
    function toggleWL(id){var l=getWL();var i=l.indexOf(id);if(i>-1)l.splice(i,1);else l.push(id);localStorage.setItem(WK,JSON.stringify(l));return l.indexOf(id)>-1}

    function loadAll(cb){
      if(allLoaded){cb&&cb();return}
      var c=sessionStorage.getItem(K.AK);
      if(c){try{allProds=JSON.parse(c);allLoaded=true;K.addMaps(allProds);cb&&cb();return}catch(e){}}
      fetch('/collections/all/products.json?limit=250').then(function(r){return r.json()}).then(function(d){
        allProds=(d&&d.products)||[];allLoaded=true;
        try{sessionStorage.setItem(K.AK,JSON.stringify(allProds))}catch(e){}
        K.addMaps(allProds);
        K.fixLinks(document);
        cb&&cb();
      }).catch(function(){allLoaded=true;cb&&cb()});
    }

    function fromSuggest(p){
      var url=p.url||'';
      var handle=(url.split('/products/')[1]||'').split('?')[0];
      return {
        _sug:true, id:p.id, title:p.title||'', handle:handle,
        vendor:p.vendor||'', type:p.type||'', tags:p.tags||[],
        available:p.available!==false,
        image:p.image||p.featured_image||'',
        _price:parseFloat(p.price_min!=null?p.price_min:(p.price!=null?p.price:0))||0,
        _cmp:parseFloat(p.compare_at_price_min!=null?p.compare_at_price_min:(p.compare_at_price!=null?p.compare_at_price:0))||0
      };
    }

    var seq=0;
    function fetchSuggest(q,cb){
      var my=++seq;
      state.loading=true;
      fetch('/search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product,query&resources[limit]=24')
        .then(function(r){return r.json()})
        .then(function(d){
          if(my!==seq)return;
          var res=((d&&d.resources)||{}).results||{};
          state.suggestProds=(res.products||[]).map(fromSuggest);
          state.suggestQueries=(res.queries||[]).map(function(x){return x.text});
          state.loading=false;cb&&cb();
        })
        .catch(function(){
          if(my!==seq)return;
          state.suggestProds=[];state.suggestQueries=[];state.loading=false;cb&&cb();
        });
    }

    function getRecent(){try{return JSON.parse(localStorage.getItem(LS))||[]}catch(e){return[]}}
    function saveRecent(q){q=(q||'').trim();if(!q)return;
      var r=getRecent().filter(function(x){return K.norm(x)!==K.norm(q)});r.unshift(q);
      try{localStorage.setItem(LS,JSON.stringify(r.slice(0,8)))}catch(e){}
      renderRecent();}
    function removeRecent(q){
      var r=getRecent().filter(function(x){return K.norm(x)!==K.norm(q)});
      try{localStorage.setItem(LS,JSON.stringify(r))}catch(e){}
      renderRecent();}
    function clearRecent(){try{localStorage.removeItem(LS)}catch(e){}renderRecent()}
    function renderRecent(){
      var el=document.getElementById('alt_recentBox');if(!el)return;
      var r=getRecent();
      if(!r.length){el.innerHTML='';return}
      el.innerHTML='<p class="kr-recent-t">Búsquedas recientes <button type="button" class="kr-rec-clear">Borrar todo</button></p>'+
        '<div class="kr-chips">'+r.map(function(x){
          return '<span class="kr-chip" data-q="'+x.replace(/"/g,'&quot;')+'">'+x+'<button type="button" class="kr-chip-x" data-delq="'+x.replace(/"/g,'&quot;')+'" aria-label="Eliminar búsqueda">&times;</button></span>';
        }).join('')+'</div>';
    }
    function renderQuerySugs(){
      var el=document.getElementById('alt_querySugs');if(!el)return;
      if(!state.suggestQueries.length||!K.norm(state.q)){el.innerHTML='';return}
      el.innerHTML='<p class="kr-recent-t">Quizás busques</p><div class="kr-chips">'+
        state.suggestQueries.slice(0,6).map(function(x){
          return '<span class="kr-chip kr-chip--sug" data-q="'+x.replace(/"/g,'&quot;')+'">'+x+'</span>';
        }).join('')+'</div>';
    }

    function results(){
      var q=K.norm2(state.q);
      if(!q)return shuffled.filter(K.ok); /* v9 */
      var list=[],ids={};
      state.suggestProds.forEach(function(p){ids[String(p.id)]=1;list.push(p)});
      allProds.forEach(function(p){
        if(ids[String(p.id)])return;
        var hit=K.norm(p.title).indexOf(K.norm(state.q))>-1||
                K.norm2(p.vendor).indexOf(q)>-1||
                K.norm2(p.type||p.product_type||'').indexOf(q)>-1||
                (p.tags||[]).some(function(t){return K.norm(t).indexOf(K.norm(state.q))>-1});
        if(hit){ids[String(p.id)]=1;list.push(p)}
      });
      CATS.forEach(function(k){
        var nk=K.norm2(k);
        if(nk.indexOf(q)===-1&&q.indexOf(nk)===-1)return;
        var c=sessionStorage.getItem(K.CK+k);
        if(!c)return;
        try{JSON.parse(c).forEach(function(p){if(!ids[String(p.id)]){ids[String(p.id)]=1;list.push(p)}})}catch(e){}
      });
      list=list.filter(K.ok); /* v9: sin stock / sin foto fuera */
      if(state.sort==='price-asc')list.sort(function(a,b){return priceOf(a)-priceOf(b)});
      else if(state.sort==='price-desc')list.sort(function(a,b){return priceOf(b)-priceOf(a)});
      else if(state.sort==='title-asc')list.sort(function(a,b){return (a.title||'').localeCompare(b.title||'')});
      return list;
    }
    function card(p){
      var id=String(p.id),fav=getWL().indexOf(id)>-1;
      var pr=priceOf(p),cp=cmpOf(p),hs=cp>pr&&cp>0;
      var img=K.wurl(K.pimg(p));
      var ft=null,ta=p.tags||[];
      for(var t=0;t<ta.length;t++){if(/personalizable|custom|nuevo|new/i.test(ta[t])){ft=ta[t];break}}
      var href=p.handle?('/products/'+p.handle):(p.url||'#');
      return '<div class="krika-product-card"><a href="'+href+'" style="display:contents;color:inherit;text-decoration:none"><div class="krika-product-thumb">'+(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'</div></a>'+
        '<div class="krika-product-info"><span class="krika-product-brand">'+(p.vendor||'').toUpperCase()+'</span>'+
        '<div class="krika-product-title-row"><a href="'+href+'" class="krika-product-title">'+p.title+'</a>'+
        '<button type="button" class="krika-wishlist-btn'+(fav?' is-active':'')+'" data-wishlist-btn data-product-id="'+id+'" aria-label="Favoritos"><svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-10-9.1C.5 8.8 2 5 5.5 5c2 0 3.4 1.1 4.2 2.4C10.5 6.1 11.9 5 13.9 5 17.4 5 18.9 8.8 17.4 11.9 15 16.4 12 21 12 21z"/></svg></button></div>'+
        '<div class="krika-product-prices">'+(hs?'<span class="krika-compare-price">'+K.fmtCOP(cp)+'</span>':'')+'<span class="krika-current-price'+(hs?' is-sale':'')+'">'+K.fmtCOP(pr)+'</span></div>'+
        (ft?'<div class="krika-product-tag">'+ft+'</div>':'')+'</div></div>';
    }
    function updateArrows(){
      var max=pGrid.scrollWidth-pGrid.clientWidth-4;
      aPrev.style.opacity=pGrid.scrollLeft<=4?'.35':'1';
      aNext.style.opacity=pGrid.scrollLeft>=max?'.35':'1';
    }
    function render(){
      var hasQ=!!K.norm(state.q);
      ov.classList.toggle('has-q',hasQ);
      if(state.loading){sMeta.innerHTML='Buscando...';}
      else{
        var list=results();
        sMeta.textContent=list.length+' resultado(s)';
        alt_btnFilters.href='/search'+(hasQ?'?q='+encodeURIComponent(state.q):'');
        pGrid.innerHTML=list.slice(0,state.visible).map(card).join('')||'<div style="color:#707070;padding:10px 0;grid-column:1/-1">No se encontraron productos.</div>';
        alt_btnMore.classList.toggle('is-visible',list.length>state.visible);
        pGrid.scrollLeft=0;
        requestAnimationFrame(updateArrows);
      }
      renderQuerySugs();
      if(!hasQ)renderRecent();
    }

    function openSearch(){
      ov.classList.add('is-open');document.body.classList.add('krika-lock');
      state.q='';sInput.value='';state.visible=INIT;state.suggestProds=[];state.suggestQueries=[];
      loadAll(function(){shuffled=K.shuffle(allProds.filter(K.ok));render()}); /* v9 */
      renderRecent();
      setTimeout(function(){sInput.focus()},80);
    }
    function closeSearch(){ov.classList.remove('is-open');document.body.classList.remove('krika-lock')}

    var trigger=document.getElementById('alt_krikaSearchTrigger');
    if(trigger){var cl=trigger.cloneNode(true);trigger.parentNode.replaceChild(cl,trigger);
      cl.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();openSearch()},true);}
    document.getElementById('alt_btnCloseSearch').addEventListener('click',closeSearch);
    document.getElementById('alt_btnCloseM').addEventListener('click',closeSearch);
    ov.addEventListener('click',function(e){if(e.target===ov)closeSearch()});
    alt_btnClear.addEventListener('click',function(){state.q='';sInput.value='';state.visible=INIT;shuffled=K.shuffle(allProds.filter(K.ok));state.suggestProds=[];state.suggestQueries=[];render();sInput.focus()});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeSearch();drawer.classList.remove('is-open','sub-open');document.body.classList.remove('krika-lock')}});

    var deb;
    sInput.addEventListener('input',function(){
      state.q=sInput.value;state.visible=INIT;
      clearTimeout(deb);
      deb=setTimeout(function(){
        if(K.norm(state.q)){fetchSuggest(state.q,render);render();}
        else{state.suggestProds=[];state.suggestQueries=[];render();}
      },220);
    });
    function goToFullSearch(e){
      var q=sInput.value.trim();
      if(!q)return;
      e.preventDefault();
      saveRecent(q);
      window.location.href='/search?q='+encodeURIComponent(q)+
        '&options[prefix]=last&options[unavailable_products]=last&options[fields]=title,vendor,product_type,tag,body,variants.title,variants.sku';
    }
    sInput.addEventListener('keydown',function(e){if(e.key==='Enter')goToFullSearch(e)});
    document.getElementById('alt_krikaSeeAll').addEventListener('click',goToFullSearch);
    alt_btnMore.addEventListener('click',function(){state.visible+=ADD;render()});

    aPrev.addEventListener('click',function(){pGrid.scrollBy({left:-pGrid.clientWidth*0.9,behavior:'smooth'})});
    aNext.addEventListener('click',function(){pGrid.scrollBy({left:pGrid.clientWidth*0.9,behavior:'smooth'})});
    pGrid.addEventListener('scroll',function(){requestAnimationFrame(updateArrows)},{passive:true});
    window.addEventListener('resize',updateArrows);

    alt_btnSort.addEventListener('click',function(e){e.stopPropagation();alt_sortMenu.classList.toggle('is-open')});
    document.addEventListener('click',function(e){
      if(!alt_sortMenu.contains(e.target)&&e.target!==alt_btnSort)alt_sortMenu.classList.remove('is-open');
      var del=e.target.closest('.kr-chip-x');
      if(del){removeRecent(del.getAttribute('data-delq'));return}
      var chip=e.target.closest('.kr-chip');
      if(chip){state.q=chip.getAttribute('data-q');sInput.value=state.q;state.visible=INIT;
        if(K.norm(state.q)){fetchSuggest(state.q,render);render();}else render();
        return}
      if(e.target.closest('.kr-rec-clear')){clearRecent();return}
    });
    alt_sortMenu.querySelectorAll('button[data-sort]').forEach(function(b){
      b.addEventListener('click',function(){
        alt_sortMenu.querySelectorAll('button').forEach(function(x){x.classList.remove('is-selected')});
        b.classList.add('is-selected');state.sort=b.getAttribute('data-sort');
        alt_sortMenu.classList.remove('is-open');state.visible=INIT;render();
      });
    });

    pGrid.addEventListener('click',function(e){var b=e.target.closest('[data-wishlist-btn]');if(!b)return;e.preventDefault();e.stopPropagation();b.classList.toggle('is-active',toggleWL(b.getAttribute('data-product-id')))});

    /* ===== DRAWER MÓVIL ===== */
    document.getElementById('alt_krikaBurger').addEventListener('click',function(){drawer.classList.add('is-open');document.body.classList.add('krika-lock')});
    document.getElementById('alt_krCloseDrawer').addEventListener('click',function(){drawer.classList.remove('is-open','sub-open');document.body.classList.remove('krika-lock')});
    document.getElementById('alt_krOverlay').addEventListener('click',function(){drawer.classList.remove('is-open','sub-open');document.body.classList.remove('krika-lock')});
    document.getElementById('alt_krSubBack').addEventListener('click',function(){drawer.classList.remove('sub-open')});
    document.querySelectorAll('[data-sub]').forEach(function(btn){
      btn.addEventListener('click',function(){
        var key=btn.getAttribute('data-sub');
        var title=btn.textContent.trim();
        var src=document.querySelector('[data-menu="'+key+'"] .krika-mega-left');
        var cats=src?src.querySelector('.krika-mega-cats'):null;
        var vermas=src?src.querySelector('.krika-mega-vermas'):null;
        var hasGroups=cats&&cats.querySelector('h5');
        document.getElementById('alt_krSubTitle').textContent=title;
        var body=document.getElementById('alt_krSubBody');
        var html='<div class="kr-sub-panel"><h4 class="kr-sub-panel-t">'+(key==='descuentos'?'EXPLORA LAS OFERTAS':(key==='kits'?'MARCAS':(hasGroups?'CATEGORÍAS':'MARCAS')))+'</h4>';
        html+=cats?'<div class="kr-sub-cats">'+cats.innerHTML+'</div>':'';
        html+='<a class="kr-sub-vermas" href="'+((vermas&&vermas.getAttribute('href'))||('/collections/'+(key==='descuentos'?'sale':key)))+'">Ver Todo '+title+'</a></div>';
        html+='<div class="kr-sub-prods" id="alt_krSubProds"><p class="krika-mega-loading">Cargando...</p></div>';
        body.innerHTML=html;
        if((key==='kits'||key==='descuentos'))body.querySelectorAll('.kr-sub-cats h5').forEach(function(el){el.remove()});
        body.querySelectorAll('.kr-sub-cats .krika-mega-vermas').forEach(function(el){el.remove()});
        body.querySelectorAll('.kr-sub-cats b').forEach(function(el){if(!el.textContent.trim())el.remove()});
        K.fixLinks(body);
        drawer.classList.add('sub-open');
        var pc=document.getElementById('alt_krSubProds');
        var done=function(prods){
          var vis=(prods||[]).filter(K.ok); /* v9 */
          pc.innerHTML=vis.slice(0,4).map(function(p){
            var img=K.wurl(K.pimg(p));
            return '<a class="kr-sub-card" href="/products/'+p.handle+'"><div class="im">'+(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'</div><div class="in"><span class="b">'+(p.vendor||'').toUpperCase()+'</span><div class="n">'+p.title+'</div><div class="p">'+K.fmtCOP(priceOf(p))+'</div></div></a>';
          }).join('')||'';
        };
        var c=sessionStorage.getItem(K.CK+key);
        if(c){try{var cached=JSON.parse(c);if(cached.filter(K.ok).length>=4){if((key==='kits'||key==='descuentos'))K.renderKitsBrands(cached,key);done(cached);return}}catch(e){}}
        var kitRequest=(key==='kits'||key==='descuentos')?K.fetchKitsProducts(key):K.loadMenuProducts(key);
        kitRequest.then(function(prods){
          if((key==='kits'||key==='descuentos')){
            try{if(prods.length)sessionStorage.setItem(K.CK+key,JSON.stringify(prods))}catch(e){}
            K.renderKitsBrands(prods,key);
          }
          K.addMaps(prods);K.fixLinks(body);
          done(prods);
        }).catch(function(){pc.innerHTML=''});
      });
    });

    fetch('/cart.js').then(function(r){return r.json()}).then(function(c){
      var n=c.item_count||0,el=document.getElementById('alt_khCartCount');
      if(n>0){el.textContent=n;el.style.display='flex'}
    }).catch(function(){});

    renderRecent();
  })();
  {% endraw %}
</script>


