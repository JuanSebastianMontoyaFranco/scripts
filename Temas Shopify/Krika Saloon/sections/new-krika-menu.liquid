    align-items: center; justify-content: center; color: #111;
  }
  #shopify-section-{{ section.id }} .kh-right svg,
  #shopify-section-{{ section.id }} .kh-burger svg {
    display: block; width: 22px; height: 22px; flex-shrink: 0;
    fill: none; stroke: currentColor; stroke-width: 1.7;
    stroke-linecap: round; stroke-linejoin: round;
  }
</style>


<style>
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .kr-panel,
    #shopify-section-{{ section.id }} .kr-dv-sub {
      transition: transform 220ms ease;
      overflow-anchor: none;
    }
    #shopify-section-{{ section.id }} .kr-overlay { transition: opacity 220ms ease; }
    #shopify-section-{{ section.id }} .kr-drawer.sub-open .kr-dv-main { visibility: visible; }
    #shopify-section-{{ section.id }} .kr-sub-body,
    #shopify-section-{{ section.id }} .kr-dv-cats { scroll-behavior: auto; overflow-anchor: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .kr-panel,
    #shopify-section-{{ section.id }} .kr-dv-sub,
    #shopify-section-{{ section.id }} .kr-overlay { transition: none; }
  }
</style>


<style>
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .kr-sub-body .kr-sub-card,
    #shopify-section-{{ section.id }} .kr-sub-body .kr-sub-card .im,
    #shopify-section-{{ section.id }} .kr-sub-body .kr-sub-card .in {
      background: #fff !important;
    }
    #shopify-section-{{ section.id }} .kr-sub-body .kr-sub-card .im img {
      mix-blend-mode: normal;
    }
  }
</style>


<style>
  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .kh-logo img,
    #shopify-section-{{ section.id }} .kh-right svg,
    #shopify-section-{{ section.id }} .kh-burger svg {
