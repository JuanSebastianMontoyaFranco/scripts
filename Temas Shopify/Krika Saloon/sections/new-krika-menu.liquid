                  assign menu_visual = block.settings.image | default: menu_visual
                  assign menu_visual_title = block.settings.caption | default: menu_visual_title
                endif
              endfor
            %}
            <a class="kr-alt-feature" href="{{ menu_collection.url | default: '/collections/sale' }}">
              {% if menu_visual != blank %}
                {{ menu_visual | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'kr-alt-feature-image', sizes: '40vw' }}
              {% endif %}
              <span class="kr-alt-feature-caption">{{ menu_visual_title | escape }}<span>Descubre la colección</span></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
