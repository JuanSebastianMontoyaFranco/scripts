{% comment %}
  Krika Menú Horizontal - Header + Buscador + Navegación (v9 - oculta sin stock y sin foto)
{% endcomment %}

<!-- Alternative header with a two-level side navigation. -->
<div class="krika-header-full">
  <div class="kh-left">
    <button type="button" class="kh-burger" id="alt_krikaBurger" aria-label="Abrir menú" aria-controls="alt_krikaDrawer" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18M3 12h18M3 19h18"/></svg><span class="kr-alt_menu-label">Menú</span>
    </button>
    <a href="/collections/all" class="kh-link">Productos</a>
    <a href="/pages/services" class="kh-link">Servicios</a>
  </div>
  <div class="kh-logo">
    <a href="/" title="Krika Salon">
      <img
        src="//cdn.shopify.com/s/files/1/0719/4027/6375/files/logo-krika-salon.png?v=1775796192"
        alt="Krika Salon"
        width="150"
      >
    </a>
  </div>
<nav class="krika-mega-nav">
  <div class="krika-mega-nav-inner">
    <div class="krika-mega-item" data-menu="gafas">
      <a href="/collections/gafas" class="krika-mega-link">Gafas
        <svg viewBox="0 0 10 6" fill="currentColor" style="width:10px;height:10px;"><path d="M1 1l4 4 4-4"/></svg>
      </a>
      <div class="krika-mega-dropdown">
        <div class="krika-mega-container">
          <div class="krika-mega-row">
            <div class="krika-mega-left">
              <h4 class="krika-mega-col-title">GAFAS</h4>
              <div class="krika-mega-cats">
                <div class="krika-mega-col">
                  <ul>
                    <li><a href="/collections/gafas?filter.p.vendor=Prada">Prada</a></li>
                    <li><a href="/collections/gafas?filter.p.vendor=Versace">Versace</a></li>
                    <li><a href="/collections/gafas?filter.p.vendor=Dolce%20%26%20Gabbana">Dolce &amp; Gabbana</a></li>
                    <li><a href="/collections/gafas?filter.p.vendor=Miu%20Miu">Miu Miu</a></li>
                  </ul>
                  <b><a href="/collections/gafas" class="krika-mega-vermas">Ver Todo Gafas</a></b>
                </div>
                <div class="krika-mega-col">
                  <ul>
                    <li><a href="/collections/gafas?filter.p.vendor=Burberry">Burberry</a></li>
                    <li><a href="/collections/gafas?filter.p.vendor=Ray-Ban">Ray-Ban</a></li>
                    <li><a href="/collections/gafas?filter.p.vendor=Tiffany">Tiffany &amp; Co.</a></li>
                    <li><a href="/collections/gafas?filter.p.vendor=Vogue">Vogue</a></li>
                  </ul>
                </div>
              </div>
            </div>
            <div class="krika-mega-products" data-collection="gafas"><p class="krika-mega-loading">Cargando...</p></div>
            {% liquid
              assign menu_collection = collections['gafas']
              assign menu_visual = menu_collection.image | default: menu_collection.products.first.featured_image
              assign menu_visual_title = menu_collection.title
              for block in section.blocks
                if block.settings.collection.handle == 'gafas'
                  assign menu_visual = block.settings.image | default: menu_visual
                  assign menu_visual_title = block.settings.caption | default: menu_visual_title
                endif
              endfor
            %}
            <a class="kr-alt-feature" href="{{ menu_collection.url | default: '/collections/gafas' }}">
              {% if menu_visual != blank %}
                {{ menu_visual | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'kr-alt-feature-image', sizes: '40vw' }}
              {% endif %}
              <span class="kr-alt-feature-caption">{{ menu_visual_title | escape }}<span>Descubre la colección</span></span>
            </a>
          </div>
        </div>
      </div>
    </div>

