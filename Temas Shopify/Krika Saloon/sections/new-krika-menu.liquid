<script>
(function(){
  function initAltNavigation(){
    var root=document.getElementById('shopify-section-{{ section.id }}');
    if(!root||root.dataset.altNavigationReady)return;
    root.dataset.altNavigationReady='true';
    var drawer=root.querySelector('#alt_krikaDrawer');
    var burger=root.querySelector('#alt_krikaBurger');
    var panel=drawer.querySelector('.kr-panel');
    var close=root.querySelector('#alt_krCloseDrawer');
    var lastCategory=null;
    function sync(){
      var open=drawer.classList.contains('is-open');
      drawer.inert=!open;
      root.querySelector('.kr-dv-main').inert=open&&drawer.classList.contains('sub-open');
      root.querySelector('.kr-dv-sub').inert=!open||!drawer.classList.contains('sub-open');
      burger.setAttribute('aria-expanded',String(open));
      root.querySelectorAll('[data-sub]').forEach(function(btn){
        btn.setAttribute('aria-expanded',String(open&&drawer.classList.contains('sub-open')&&btn.textContent.trim()===root.querySelector('#alt_krSubTitle').textContent));
      });
    }
    new MutationObserver(sync).observe(drawer,{attributes:true,attributeFilter:['class']});
    burger.addEventListener('click',function(){
      if(window.matchMedia('(min-width: 769px)').matches&&!drawer.classList.contains('sub-open'))root.querySelector('[data-sub]').click();
      sync();close.focus({preventScroll:true});
    });
    root.querySelectorAll('[data-sub]').forEach(function(btn){btn.addEventListener('click',function(){
      lastCategory=btn;
      sync();
      if(window.matchMedia('(max-width: 768px)').matches)root.querySelector('#alt_krSubBack').focus({preventScroll:true});
    })});
    root.querySelector('#alt_krSubBack').addEventListener('click',function(){sync();if(lastCategory)lastCategory.focus({preventScroll:true})});
    close.addEventListener('click',function(){burger.focus({preventScroll:true})});
    root.querySelector('#alt_krOverlay').addEventListener('click',function(){burger.focus({preventScroll:true})});
    document.addEventListener('keydown',function(e){
      if(!drawer.classList.contains('is-open'))return;
      if(e.key==='Escape'){burger.focus({preventScroll:true});return}
      if(e.key!=='Tab')return;
      var focusable=Array.from(panel.querySelectorAll('a[href],button,input,select,[tabindex="0"]')).filter(function(el){return !el.disabled&&!el.closest('[inert]')&&el.getClientRects().length&&getComputedStyle(el).visibility!=='hidden'});
      var first=focusable[0],last=focusable[focusable.length-1];
      if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus({preventScroll:true})}
      else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus({preventScroll:true})}
    });
    sync();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAltNavigation);else initAltNavigation();
  document.addEventListener('shopify:section:load',initAltNavigation);
})();
</script>


