<style>
  :root {
    --krika-bg: #fff;
    --krika-text: #000;
    --krika-muted: #707070;
    --krika-border: #000;
    --krika-divider: #eaeaea;
    --krika-sale: #c0392b;
    --krika-wish: #c0392b;
    --krika-cardline: #e5e5e5;
    --krika-card-w: 190px;
    --krika-card-h: 265px;
  }
  body.krika-lock { overflow: hidden; }

  /* HEADER */
  .krika-header-full {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px 100px;
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 999;
  }
  .kh-left { display: flex; align-items: center; gap: 18px; }
  .kh-link {
    font-size: 13px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #000; text-decoration: none;
  }
  .kh-logo a { display: block; line-height: 0; }
  .kh-logo img { width: 95px; height: auto; display: block; margin: 1rem 0; }
  .kh-right { display: flex; justify-content: flex-end; align-items: center; gap: 4px; padding-left: 24px; }
  .kh-right a, .kh-right button {
    color: #000; display: inline-flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; padding: 9px 10px;
    text-decoration: none; position: relative; outline: none;
  }
  .kh-cart-n {
    position: absolute; top: 3px; right: 3px; background: #000; color: #fff;
    font-size: 9px; min-width: 14px; height: 14px; border-radius: 999px;
    display: none; align-items: center; justify-content: center; padding: 0 3px;
  }
  .kh-burger { background: none; border: none; cursor: pointer; padding: 6px; color: #000; }

  /* NAVBAR + MEGA */
  .krika-mega-nav { background: #fff; border-bottom: 1px solid #eee; padding: 8px 30px; position: relative; }
  .krika-mega-nav-inner { display: flex; justify-content: center; align-items: center; gap: 28px; }
  .krika-mega-item { position: static; }
  .krika-mega-link {
    display: flex; align-items: center; gap: 6px; text-decoration: none; color: #000;
    font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em;
    padding: 8px 2px; cursor: pointer; background: none; border: none;
  }
  .krika-mega-link:hover { opacity: 0.6; }
  .krika-mega-link svg { transition: transform 0.3s; }
  .krika-mega-item:hover .krika-mega-link svg { transform: rotate(180deg); }
  .krika-mega-dropdown {
    position: absolute; top: 100%; left: 0; right: 0; background: #f2f2f2;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08); opacity: 0; visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s; z-index: 998;
  }
  .krika-mega-item:hover .krika-mega-dropdown { opacity: 1; visibility: visible; }
  .krika-mega-container { padding: 10px 300px; background: #fff; }
  .krika-mega-row {
    display: grid; grid-template-columns: 405px 1fr; gap: 50px;
    align-items: start; background: #f2f2f2; padding: 2rem;
  }
  .krika-mega-col-title {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    color: #1a1a1a; margin: 0; padding-bottom: 12px; border-bottom: 1px solid #cfcfcf;
  }
  .krika-mega-cats { display: flex; gap: 26px; margin-top: 14px; }
  .krika-mega-col { flex: 1; min-width: 0; }
  .krika-mega-col h5 {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: #1a1a1a; margin: 0 0 10px;
  }
  .krika-mega-col ul { list-style: none; padding: 0; margin: 0; }
  .krika-mega-col li { margin-bottom: 10px; }
  .krika-mega-col li a { font-size: 13px; color: #666; text-decoration: none; line-height: 1.3; }
  .krika-mega-col li a:hover { color: #000; }
  .krika-mega-cats--kits .krika-mega-col { width: 100%; }
  .krika-mega-cats--kits [data-kits-brand-list] { columns: 2; column-gap: 24px; }
  .krika-mega-cats--kits [data-kits-brand-list] li { break-inside: avoid; }
  .krika-mega-vermas {
    display: inline-block; margin-top: 6px; font-size: 13px; font-weight: 900 !important;
    color: #666; text-decoration: underline; text-underline-offset: 4px;
  }
  .krika-mega-vermas:hover { color: #000; }

  /* TARJETAS */
  .krika-mega-products { display: grid; grid-template-columns: repeat(4, var(--krika-card-w)); gap: 14px; }
  .krika-mega-card, .krika-product-card, .kr-sub-card {
    position: relative; display: flex; flex-direction: column;
    height: var(--krika-card-h); background: #fff;
    border: 1px solid var(--krika-cardline); overflow: hidden;
  }
  .krika-mega-card { width: var(--krika-card-w); }
  .krika-mega-card::after, .krika-product-card::after, .kr-sub-card::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 2px;
    background: #000; transform: scaleX(0); transform-origin: left center; transition: transform 0.25s ease;
  }
  .krika-mega-card:hover::after, .krika-mega-card:active::after,
  .krika-product-card:hover::after, .krika-product-card:active::after,
  .kr-sub-card:hover::after, .kr-sub-card:active::after { transform: scaleX(1); }
  .krika-mega-card a { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .krika-mega-img, .krika-product-thumb, .kr-sub-card .im {
    flex: 1; min-height: 0; background: #fff;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .krika-mega-img img, .krika-product-thumb img, .kr-sub-card .im img {
    max-width: 80%; max-height: 80%; object-fit: contain;
  }
  .krika-mega-info, .krika-product-info, .kr-sub-card .in {
    padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 4px;
  }
  .krika-mega-brand, .krika-product-brand, .kr-sub-card .b {
    font-size: 9px; font-weight: 600; color: #999; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .krika-mega-name, .krika-product-title, .kr-sub-card .n {
    font-size: 11px; font-weight: 700; color: #000; margin: 0;
    text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.35;
  }
  .krika-product-title {
    text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }
  .krika-mega-price, .krika-product-prices, .kr-sub-card .p { font-size: 11px; color: #000; font-weight: 500; }
  .krika-mega-loading { grid-column: 1/-1; font-size: 11px; color: #888; text-align: center; padding: 40px 20px; }
  @media (max-width: 1200px) {
    .krika-mega-products { grid-template-columns: repeat(4, 1fr); }
    .krika-mega-card { width: auto; }
  }

  /* Keep every desktop dropdown and its cards within the available viewport. */
  .krika-mega-nav .krika-mega-container {
    box-sizing: border-box;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 16px 24px;
  }
  .krika-mega-nav .krika-mega-row {
    grid-template-columns: minmax(260px, 1fr) minmax(0, 2fr);
    gap: 28px;
    padding: 24px;
  }
  .krika-mega-nav .krika-mega-left,
  .krika-mega-nav .krika-mega-products {
    min-width: 0;
  }
  .krika-mega-nav :is([data-menu="kits"], [data-menu="descuentos"]) [data-kits-brand-list] {
    columns: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
  }
  .krika-mega-nav :is([data-menu="kits"], [data-menu="descuentos"]) [data-kits-brand-list] li {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .krika-mega-nav :is([data-menu="kits"], [data-menu="descuentos"]) [data-kits-brand-list] a {
    display: block;
    font-size: 12px;
    line-height: 1.5;
  }
  .krika-mega-nav .krika-mega-vermas {
    margin-top: 20px;
  }
  .krika-mega-nav .krika-mega-products {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .krika-mega-nav .krika-mega-card {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    height: 265px;
  }
  .krika-mega-nav .krika-mega-info {
    min-height: 100px;
    box-sizing: border-box;
  }
  .krika-mega-nav .krika-mega-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    line-height: 1.35;
  }
  .krika-mega-nav .krika-mega-price {
    margin-top: auto;
  }
  @media (min-width: 769px) and (max-width: 1100px) {
    .krika-mega-nav .krika-mega-row {
      grid-template-columns: minmax(240px, 1fr) minmax(0, 1.4fr);
      gap: 20px;
      padding: 20px;
    }
    .krika-mega-nav .krika-mega-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .krika-mega-nav .krika-mega-dropdown {
      max-height: 75vh;
      overflow-y: auto;
    }
  }

  /* DRAWER */
  .kr-drawer { position: fixed; inset: 0; z-index: 99999; pointer-events: none; }
  .kr-drawer.is-open { pointer-events: auto; }
  .kr-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.35); opacity: 0; transition: 0.25s; }
  .kr-drawer.is-open .kr-overlay { opacity: 1; }
  .kr-panel {
    position: absolute; top: 0; bottom: 0; left: 0; width: min(85vw, 340px);
    background: #fff; transform: translateX(-100%); transition: 0.28s; overflow: hidden;
  }
  .kr-drawer.is-open .kr-panel { transform: none; }
  .kr-dv-main { display: flex; flex-direction: column; height: 100%; }
  .kr-mhead { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; font-size: 14px; }
  .kr-x { background: none; border: none; cursor: pointer; color: #000; padding: 4px; display: inline-flex; }
  .kr-dv-cats { flex: 1; overflow: auto; padding: 4px 0; }
  .kr-cat {
    display: flex; justify-content: space-between; align-items: center; width: 100%;
    padding: 15px 20px; font-size: 15px; color: #333; background: none; border: 0;
    cursor: pointer; text-decoration: none; text-align: left;
  }
  .kr-dv-foot { padding: 18px 20px; border-top: 1px solid #eee; }
  .kr-dv-foot p { margin: 0 0 12px; font-size: 15px; }
  .kr-btn {
    display: block; width: 100%; padding: 12px; text-align: center; font-size: 14px;
    text-decoration: none; margin-bottom: 10px; border: 1px solid #000; color: #000;
  }
  .kr-btn--dark { background: #222; color: #fff; }
  .kr-dv-sub {
    position: absolute; inset: 0; background: #fff; transform: translateX(100%);
    transition: 0.28s; display: flex; flex-direction: column;
  }
  .kr-drawer.sub-open .kr-dv-sub { transform: none; }
  .kr-sub-head {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px;
    border-bottom: 1px solid #eee; background: none; border-left: 0; border-right: 0;
    border-top: 0; font-size: 15px; cursor: pointer;
  }
  .kr-sub-body { flex: 1; overflow: auto; padding: 16px; }
  .kr-sub-body,
  .kr-sub-body .kr-sub-panel,
  .kr-sub-body .kr-sub-card,
  .kr-sub-body .kr-sub-card .im,
  .kr-sub-body .kr-sub-card .in {
    background: #f7f7f7;
  }
  .kr-sub-body .kr-sub-card .im img {
    mix-blend-mode: multiply;
  }

  /* SUB MÓVIL (panel como captura) */
  .kr-sub-panel { background: #f7f7f7; margin: 0 -16px; padding: 14px 16px 12px; }
  .kr-sub-panel-t {
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: #1a1a1a; margin: 0; padding-bottom: 10px; border-bottom: 1px solid #dcdcdc;
  }
  .kr-sub-cats { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 18px; margin-top: 6px; }
  .kr-sub-cats .krika-mega-col { flex: none; min-width: 0; }
  .kr-sub-cats ul { list-style: none; margin: 0; padding: 0; }
  .kr-sub-cats:has([data-kits-brand-list]) { display: block; }
  .kr-sub-cats [data-kits-brand-list] {
    display: block;
    columns: 2;
    column-gap: 18px;
  }
  .kr-sub-cats [data-kits-brand-list] li {
    min-width: 0;
    break-inside: avoid;
  }
  .kr-sub-cats [data-kits-brand-list] a { overflow-wrap: anywhere; }
  .kr-sub-cats li { margin: 0; }
  .kr-sub-cats li a {
    display: block;
    padding: 9px 0;
