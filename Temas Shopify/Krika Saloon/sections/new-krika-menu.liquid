    }
    #shopify-section-{{ section.id }} .kh-logo a:hover img,
    #shopify-section-{{ section.id }} .kh-right > a:hover svg,
    #shopify-section-{{ section.id }} .kh-right > button:hover svg,
    #shopify-section-{{ section.id }} .kh-burger:hover svg {
      transform: scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .kh-logo img,
    #shopify-section-{{ section.id }} .kh-right svg,
    #shopify-section-{{ section.id }} .kh-burger svg {
      transition: none;
      transform: none !important;
    }
  }
</style>


<style>
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .kr-mhead > span { display: none; }
