      "label": "Padding Lateral del Título",
      "default": 20,
      "min": 0,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Ancho de la Sección",
      "options": [
        { "value": "full", "label": "Full Width (100% de la pantalla)" },
